diff --git a/src/ieu/datapath.sv b/src/ieu/datapath.sv
index 5ca52d829..5feb62393 100644
--- a/src/ieu/datapath.sv
+++ b/src/ieu/datapath.sv
@@ -77,7 +77,12 @@ module datapath import cvw::*;  #(parameter cvw_t P) (
   input  logic [P.XLEN-1:0] CSRReadValW,             // CSR read result
   input  logic [P.XLEN-1:0] MDUResultW,              // MDU (Multiply/divide unit) result
   input  logic [P.XLEN-1:0] FIntDivResultW,          // FPU's integer divide result
-  input  logic [4:0]        RdW                      // Destination register
+  input  logic [4:0]        RdW,                     // Destination register
+  input  logic [4:0]        RdE,                      // Destination register in Execute stage (for amocas forwarding)
+  input  logic [4:0]        RdM,                      // Destination register in Memory stage (for amocas forwarding)
+  input  logic              RegWriteE,                // Instruction writes register in Execute stage (for amocas forwarding)
+  input  logic              RegWriteM,                // Instruction writes register in Memory stage (for amocas forwarding)
+  input  logic              AMOCASPairD               // Pair amocas in Decode stage (for amocas forwarding)
    // Hazard Unit signals
 );
 
@@ -95,6 +100,10 @@ module datapath import cvw::*;  #(parameter cvw_t P) (
   logic [P.XLEN*2-1:0] ComparePairD, ComparePairE;   // amocas compare operand on its way to the LSU
   logic [P.XLEN-1:0]   SwapHighD, SwapHighE;         // amocas swap value for rd+1 on its way to the LSU
   logic [P.XLEN-1:0] IEUAdrRawE;                     // ALU sum before clearing bit 0 of a jump target
+  // amocas compare operand forwarding
+  logic [P.XLEN-1:0] CompareRdLowD;                  // Forwarded compare rd low half
+  logic [P.XLEN-1:0] CompareRdHighD;                 // Forwarded compare rd high half
+  logic [4:0]         RdPlus1D;                       // rd+1 for pair amocas forwarding
   // Memory stage signals
   logic [P.XLEN-1:0] IEUResultM;                     // Result from execution stage
   logic [P.XLEN-1:0] IFResultM;                      // Result from either IEU or single-cycle FPU op writing an integer register
@@ -116,7 +125,35 @@ module datapath import cvw::*;  #(parameter cvw_t P) (
   assign SwapHighD = R2PD[P.XLEN*2-1:P.XLEN]; // X(rs2+1); X(rs2) already reaches the LSU as WriteDataM
   // The low half must be X(rd) itself, which R2D selects; the pair forms have an even rd so the
   // two agree there, while a scalar amocas with an odd rd needs the selected half.
-  flopenr #(P.XLEN*2) ComparePairDReg(clk, reset, CASStallD, {R2PD[P.XLEN*2-1:P.XLEN], R2D}, ComparePairD);
+  // Forwarding for amocas compare operand: when CASStallD is active, forward from E/M/W stages
+  // if there is a RAW hazard on rd (or rd+1 for pair amocas) instead of using stale regfile data.
+  assign RdPlus1D = InstrD[11:7] + 5'b00001;
+
+  // Forward low half (rd) for the compare operand
+  always_comb begin
+    if (CASStallD & (InstrD[11:7] == RdE) & RegWriteE & (InstrD[11:7] != 5'b0))
+      CompareRdLowD = IEUResultE;  // forward from Execute stage
+    else if (CASStallD & (InstrD[11:7] == RdM) & RegWriteM & (InstrD[11:7] != 5'b0))
+      CompareRdLowD = IFResultM;   // forward from Memory stage
+    else if (CASStallD & (InstrD[11:7] == RdW) & RegWriteW & (InstrD[11:7] != 5'b0))
+      CompareRdLowD = ResultW;     // forward from Writeback stage
+    else
+      CompareRdLowD = R2D;         // default: read from register file
+  end
+
+  // Forward high half (rd+1) for pair amocas compare operand
+  always_comb begin
+    if (CASStallD & AMOCASPairD & (RdPlus1D == RdE) & RegWriteE & (RdPlus1D != 5'b0))
+      CompareRdHighD = IEUResultE;  // forward from Execute stage
+    else if (CASStallD & AMOCASPairD & (RdPlus1D == RdM) & RegWriteM & (RdPlus1D != 5'b0))
+      CompareRdHighD = IFResultM;   // forward from Memory stage
+    else if (CASStallD & AMOCASPairD & (RdPlus1D == RdW) & RegWriteW & (RdPlus1D != 5'b0))
+      CompareRdHighD = ResultW;     // forward from Writeback stage
+    else
+      CompareRdHighD = R2PD[P.XLEN*2-1:P.XLEN]; // default: read from register file
+  end
+
+  flopenr #(P.XLEN*2) ComparePairDReg(clk, reset, CASStallD, {CompareRdHighD, CompareRdLowD}, ComparePairD);
   flopenrc #(P.XLEN*2) ComparePairEReg(clk, reset, FlushE, ~StallE, ComparePairD, ComparePairE);
   flopenrc #(P.XLEN*2) ComparePairMReg(clk, reset, FlushM, ~StallM, ComparePairE, ComparePairM);
   flopenrc #(P.XLEN) SwapHighEReg(clk, reset, FlushE, ~StallE, SwapHighD, SwapHighE);
