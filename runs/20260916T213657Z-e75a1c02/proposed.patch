+cat << 'TESTEOF' > $TEST_DIR/tests/test_zacas_rd1_hazard.S
+.section .text.init
+.globl rvtest_entry_point
+rvtest_entry_point:
+    # Initialize PMP to allow all accesses
+    li t0, -1
+    csrw pmpaddr0, t0
+    li t0, 0x1F
+    csrw pmpcfg0, t0
+
+    # Load address of test_val into a0
+    la a0, test_val
+
+    # Set up registers: compare value in a2:a3
+    li a2, 42
+    li a3, 100
+    # Swap value in a4:a5
+    li a4, 99
+    li a5, 999
+
+    nop
+    nop
+    nop
+
+    # Memory holds {42, 777}. Compare value {42, 100} mismatches.
+    # amocas.q loads memory {42, 777} into register pair a2:a3 (a2=42, a3=777).
+    amocas.q a2, a4, (a0)
+
+    # Immediately consume a3 (rd+1) with 0 NOP distance
+    addi a6, a3, 0
+
+    # Check result
+    li t1, 777
+    beq a6, t1, pass
+
+fail:
+    csrw mtvec, x0
+    jr x0
+
+pass:
+    la t0, tohost
+    li t1, 1
+    sd t1, 0(t0)
+    .option norvc
+1:  j 1b
+
+.section .data
+.align 4
+test_val:
+    .dword 42
+    .dword 777
+
+.section .tohost, "aw", @progbits
+.align 6
+.globl tohost
+tohost: .dword 0
+.globl fromhost
+fromhost: .dword 0
