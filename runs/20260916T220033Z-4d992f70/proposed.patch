diff --git a/src/ieu/controller.sv b/src/ieu/controller.sv
index eb034d67f..86236716d 100644
--- a/src/ieu/controller.sv
+++ b/src/ieu/controller.sv
@@ -157,6 +157,7 @@ module controller import cvw::*;  #(parameter cvw_t P) (
   logic        AMOCASPairD, AMOCASPairE;       // instruction is a register-pair amocas (opcode included)
   logic        CASCapturedD;                   // the borrowed rs2 read has happened, so stop stalling
   logic        CASStallD;                      // hold amocas in Decode for the borrowed read or a hazard
+  logic        AMOCASPairStallD;               // stall for rd+1 hazard when AMOCAS pair is in Execute
   logic        CASHazardD;                     // an older instruction still owes amocas one of its operands
   logic        CASMatchE, CASMatchM;           // that instruction is in Execute / Memory
   logic        A3264FunctD;                    // Detect valid 32/64-bit atomics (lr/sc/amo)
@@ -523,25 +524,37 @@ module controller import cvw::*;  #(parameter cvw_t P) (
   assign CSRWriteFenceM = CSRWriteM | FenceM;
 
   // Forwarding logic
+  // ForwardAE/ForwardBE encoding:
+  //   00 = no forward (use register file value)
+  //   01 = forward from Writeback stage (ResultW)
+  //   10 = forward from Memory stage (IFResultM)
+  //   11 = forward rd+1 high half from Writeback stage (ReadDataHighW, for AMOCAS pairs)
+  // Note: The MatchDE stall for rd+1 of AMOCAS pairs ensures the dependent instruction
+  // reaches Execute exactly when the AMOCAS pair reaches Writeback, so AMOCASPairW
+  // forwarding suffices. AMOCASPairM forwarding is not needed because IFResultM does
+  // not contain the loaded high-half value for amocas.
   always_comb begin
     ForwardAE = 2'b00;
     ForwardBE = 2'b00;
     if (Rs1E != 5'b0)
-      if      ((Rs1E == RdM) & RegWriteM) ForwardAE = 2'b10;
-      else if ((Rs1E == RdW) & RegWriteW) ForwardAE = 2'b01;
+      if      ((Rs1E == RdM) & RegWriteM)                        ForwardAE = 2'b10;
+      else if ((Rs1E == RdW) & RegWriteW)                        ForwardAE = 2'b01;
+      else if (AMOCASPairW & (Rs1E == (RdW | 5'b1)) & RegWriteW) ForwardAE = 2'b11;
 
     if (Rs2E != 5'b0)
-      if      ((Rs2E == RdM) & RegWriteM) ForwardBE = 2'b10;
-      else if ((Rs2E == RdW) & RegWriteW) ForwardBE = 2'b01;
+      if      ((Rs2E == RdM) & RegWriteM)                        ForwardBE = 2'b10;
+      else if ((Rs2E == RdW) & RegWriteW)                        ForwardBE = 2'b01;
+      else if (AMOCASPairW & (Rs2E == (RdW | 5'b1)) & RegWriteW) ForwardBE = 2'b11;
   end
 
   // Stall on dependent operations that finish in Mem Stage and can't bypass in time
   // Structural hazard causes stall if any of these events occur
-  assign MatchDE = ((Rs1D == RdE) | (Rs2D == RdE)) & (RdE != 5'b0); // Decode-stage instruction source depends on result from execute stage instruction
+  assign MatchDE = (((Rs1D == RdE) | (Rs2D == RdE)) & (RdE != 5'b0)) | (AMOCASPairE & (RdE != 5'b0) & ((Rs1D == (RdE | 5'b1)) | (Rs2D == (RdE | 5'b1)))); // Decode-stage source depends on execute-stage result; also checks rd+1 for AMOCAS pairs
   assign LoadStallD = (MemReadE|SCE) & MatchDE;
   assign StoreStallD = MemRWD[1] & MemRWE[0];   // Store or AMO followed by load or AMO
   assign CSRRdStallD = CSRReadE & MatchDE;
   assign MDUStallD = MDUE & MatchDE; // Int mult/div is at least two cycle latency, even when coming from the FDIV
   assign FCvtIntStallD = FCvtIntE & MatchDE; // FPU to Integer transfers have single-cycle latency except fcvt
-  assign StructuralStallD = LoadStallD | StoreStallD | CSRRdStallD | MDUStallD | FCvtIntStallD | CASStallD;
+  assign AMOCASPairStallD = AMOCASPairE & (RdE != 5'b0) & ((Rs1D == (RdE | 5'b1)) | (Rs2D == (RdE | 5'b1)));
+  assign StructuralStallD = LoadStallD | StoreStallD | CSRRdStallD | MDUStallD | FCvtIntStallD | CASStallD | AMOCASPairStallD;
 endmodule
diff --git a/src/ieu/datapath.sv b/src/ieu/datapath.sv
