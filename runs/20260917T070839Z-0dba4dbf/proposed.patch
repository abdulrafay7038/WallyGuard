diff --git a/src/mmu/pmpchecker.sv b/src/mmu/pmpchecker.sv
index 4d14c9675..5263238c4 100644
--- a/src/mmu/pmpchecker.sv
+++ b/src/mmu/pmpchecker.sv
@@ -60,6 +60,13 @@ module pmpchecker import cvw::*;  #(parameter cvw_t P) (
   logic [2:0]                      SizeBytesMinus1;
   logic                            MatchingR, MatchingW, MatchingX, MatchingL;
 
+  // End address for PMP boundary crossing detection
+  logic [P.PA_BITS-1:0]            EndAddress;
+  logic [P.PMP_ENTRIES-1:0]        EndMatch;
+  logic [P.PMP_ENTRIES-1:0]        EndFirstMatch;
+  logic [P.PMP_ENTRIES-1:0]        EndPAgePMPAdr;
+  logic                            PMPBoundaryFault;
+
 
   if (P.PMP_ENTRIES > 0) begin: pmp // prevent complaints about array of no elements when PMP_ENTRIES = 0
     pmpadrdec #(P) pmpadrdecs[P.PMP_ENTRIES-1:0](
@@ -73,6 +80,27 @@ module pmpchecker import cvw::*;  #(parameter cvw_t P) (
       .Match, .L, .X, .W, .R);
   end
 
+  // Compute end (last byte) address of the multi-byte access
+  assign SizeBytesMinus1 = (2**Size) - 1;
+  assign EndAddress = PhysicalAddress + {{(P.PA_BITS-3){1'b0}}, SizeBytesMinus1};
+
+  // Second set of PMP address decoders for the end address to detect boundary crossings
+  if (P.PMP_ENTRIES > 0) begin: pmpend
+    pmpadrdec #(P) pmpendadrdecs[P.PMP_ENTRIES-1:0](
+      .PhysicalAddress(EndAddress),
+      .Size,
+      .PMPCfg(PMPCFG_ARRAY_REGW),
+      .PMPAdr(PMPADDR_ARRAY_REGW),
+      .FirstMatch(1'b0),
+      .PAgePMPAdrIn({EndPAgePMPAdr[P.PMP_ENTRIES-2:0], 1'b1}),
+      .PAgePMPAdrOut(EndPAgePMPAdr),
+      .Match(EndMatch), .L(), .X(), .W(), .R());
+
+    priorityonehot #(P.PMP_ENTRIES) pmppriority_end(.a(EndMatch), .y(EndFirstMatch));
+  end else begin: pmpend_none
+    assign EndFirstMatch = '0;
+  end
+
   priorityonehot #(P.PMP_ENTRIES) pmppriority(.a(Match), .y(FirstMatch)); // combine the match signal from all the address decoders to find the first one that matches.
 
   // Distributed AND-OR mux to select the first matching results
@@ -84,11 +112,15 @@ module pmpchecker import cvw::*;  #(parameter cvw_t P) (
   // Only enforce PMP checking for effective S and U modes (accounting for mstatus.MPRV) or in Machine mode when L bit is set in selected region
   assign EnforcePMP = (EffectivePrivilegeModeW != P.M_MODE) | MatchingL;
 
+  // Detect PMP boundary crossing: access's first and last bytes match different PMP entries
+  assign PMPBoundaryFault = EnforcePMP & (FirstMatch != EndFirstMatch);
+
   assign PMPCBOMAccessFault     = EnforcePMP & (|CMOpM[2:0]) & ~MatchingR ; // checking R is sufficient because W implies R in PMP  // exclusion-tag: immu-pmpcbom
   assign PMPCBOZAccessFault     = EnforcePMP & CMOpM[3] & ~MatchingW ;          // exclusion-tag: immu-pmpcboz
   assign PMPCMOAccessFault      = PMPCBOZAccessFault | PMPCBOMAccessFault;              // exclusion-tag: immu-pmpcboaccess
 
-  assign PMPInstrAccessFaultF     = EnforcePMP & ExecuteAccessF & ~MatchingX ;
-  assign PMPStoreAmoAccessFaultM  = (EnforcePMP & WriteAccessM & ~MatchingW)  | PMPCMOAccessFault; // exclusion-tag: immu-pmpstoreamoaccessfault
-  assign PMPLoadAccessFaultM      = EnforcePMP & ReadAccessM & ~WriteAccessM & ~MatchingR;
+  assign PMPInstrAccessFaultF     = (EnforcePMP & ExecuteAccessF & ~MatchingX) | (PMPBoundaryFault & ExecuteAccessF);
+  assign PMPStoreAmoAccessFaultM  = ((EnforcePMP & WriteAccessM & ~MatchingW)  | PMPCMOAccessFault) | (PMPBoundaryFault & WriteAccessM); // exclusion-tag: immu-pmpstoreamoaccessfault
+  assign PMPLoadAccessFaultM      = (EnforcePMP & ReadAccessM & ~WriteAccessM & ~MatchingR) | (PMPBoundaryFault & ReadAccessM & ~WriteAccessM);
+
  endmodule
