   //                  - rather have a few and-gates than an extra bit in the priority encoder???
   always_comb
       if(ToInt)                       ShiftAmt = Ce[P.LOGCVTLEN-1:0]&{P.LOGCVTLEN{~Ce[P.NE]}};
-      else if (ResSubnormUf)          ShiftAmt = (P.LOGCVTLEN)'(P.NF-1)+Ce[P.LOGCVTLEN-1:0];
+      // Undo the leading zero shift: a subnormal source needs no normalizing when the result is also
+      // subnormal, and LeadingZeros is already zero for a normal one.  Only same-precision converts
+      // reach that combination: narrowing flushes such a source to zero and widening normalizes it.
+      else if (ResSubnormUf)          ShiftAmt = (P.LOGCVTLEN)'(P.NF-1)+Ce[P.LOGCVTLEN-1:0]+LeadingZeros;
       else                            ShiftAmt = LeadingZeros;
 
   ///////////////////////////////////////////////////////////////////////////

