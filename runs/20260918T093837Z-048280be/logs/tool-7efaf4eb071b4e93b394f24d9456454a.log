Command: bash -o pipefail -c 'TEST_DIR=/home/rafay/miniconda3/WallyGuard2/runs/20260918T093837Z-048280be
WALLY_CLEAN=$TEST_DIR/build/wally_clean

cat << '"'"'EOF'"'"' > $TEST_DIR/build/clean_src/clean_conflict_head.py
import sys

def clean_file(in_path):
    with open(in_path, '"'"'r'"'"') as f:
        lines = f.readlines()
    
    with open(in_path, '"'"'w'"'"') as f:
        state = 0 # 0: normal, 1: in HEAD, 2: in incoming
        for line in lines:
            if line.startswith('"'"'<<<<<<<'"'"'):
                state = 1
                continue
            elif line.startswith('"'"'======='"'"'):
                state = 2
                continue
            elif line.startswith('"'"'>>>>>>>'"'"'):
                state = 0
                continue
            
            if state == 0 or state == 1:
                f.write(line)

for file in sys.argv[1:]:
    clean_file(file)
EOF

# Restore from original WALLY
rsync -a $WALLY/src/fpu/fcvt.sv $WALLY_CLEAN/src/fpu/fcvt.sv
rsync -a $WALLY/src/fpu/postproc/round.sv $WALLY_CLEAN/src/fpu/postproc/round.sv
rsync -a $WALLY/src/fpu/postproc/specialcase.sv $WALLY_CLEAN/src/fpu/postproc/specialcase.sv
rsync -a $WALLY/src/fpu/unpack.sv $WALLY_CLEAN/src/fpu/unpack.sv
rsync -a $WALLY/config/rv64gc/config.vh $WALLY_CLEAN/config/rv64gc/config.vh
rsync -a $WALLY/config/shared/parameter-defs.vh $WALLY_CLEAN/config/shared/parameter-defs.vh

# Clean to HEAD
python3 $TEST_DIR/build/clean_src/clean_conflict_head.py $WALLY_CLEAN/src/fpu/fcvt.sv $WALLY_CLEAN/src/fpu/postproc/round.sv $WALLY_CLEAN/src/fpu/postproc/specialcase.sv $WALLY_CLEAN/src/fpu/unpack.sv $WALLY_CLEAN/config/rv64gc/config.vh $WALLY_CLEAN/config/shared/parameter-defs.vh

