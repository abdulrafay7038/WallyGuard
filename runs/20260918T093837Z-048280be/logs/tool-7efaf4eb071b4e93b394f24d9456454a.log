# Fix missing declarations in specialcase.sv (UfResFmt was missing?) Let'"'"'s check if it compiles.
make -C $WALLY_CLEAN/sim/verilator clean
make -C $WALLY_CLEAN/sim/verilator compile WALLY=$WALLY_CLEAN WALLYCONF=rv64gc TESTBENCH=testbench WORKDIR=$TEST_DIR/build/rv64gc_testbench'

