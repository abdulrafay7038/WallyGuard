Command: bash -o pipefail -c 'cat << '"'"'EOF'"'"' > /home/rafay/miniconda3/WallyGuard2/runs/20260918T105234Z-b204db37/build_reproducer.sh
#!/bin/bash
set -e
export TEST_DIR=/home/rafay/miniconda3/WallyGuard2/runs/20260918T105234Z-b204db37
export WALLY=/home/rafay/miniconda3/WallyGuard2/wally-worktrees/wally-shared
export PATH=/home/rafay/riscv/bin:$PATH

echo "Cleaning up conflicting headers..."
cp $WALLY/config/rv64gc/config.vh $TEST_DIR/build/clean_inc/rv64gc/config.vh
cp $WALLY/config/shared/parameter-defs.vh $TEST_DIR/build/clean_inc/shared/parameter-defs.vh

sed -i '"'"'/<<<<<<</d'"'"' $TEST_DIR/build/clean_inc/rv64gc/config.vh
sed -i '"'"'/=======/d'"'"' $TEST_DIR/build/clean_inc/rv64gc/config.vh
sed -i '"'"'/>>>>>>>/d'"'"' $TEST_DIR/build/clean_inc/rv64gc/config.vh

sed -i '"'"'/<<<<<<</d'"'"' $TEST_DIR/build/clean_inc/shared/parameter-defs.vh
sed -i '"'"'/=======/d'"'"' $TEST_DIR/build/clean_inc/shared/parameter-defs.vh
sed -i '"'"'/>>>>>>>/d'"'"' $TEST_DIR/build/clean_inc/shared/parameter-defs.vh

echo "Cleaning up conflicting SV files..."
cp $WALLY/src/fpu/fcvt.sv $TEST_DIR/build/clean_src/fcvt.sv
cp $WALLY/src/fpu/postproc/round.sv $TEST_DIR/build/clean_src/round.sv
cp $WALLY/src/fpu/postproc/specialcase.sv $TEST_DIR/build/clean_src/specialcase.sv
cp $WALLY/src/fpu/unpack.sv $TEST_DIR/build/clean_src/unpack.sv

sed -i '"'"'/<<<<<<</d'"'"' $TEST_DIR/build/clean_src/fcvt.sv
sed -i '"'"'/=======/d'"'"' $TEST_DIR/build/clean_src/fcvt.sv
sed -i '"'"'/>>>>>>>/d'"'"' $TEST_DIR/build/clean_src/fcvt.sv

sed -i '"'"'/<<<<<<</d'"'"' $TEST_DIR/build/clean_src/round.sv
sed -i '"'"'/=======/d'"'"' $TEST_DIR/build/clean_src/round.sv
sed -i '"'"'/>>>>>>>/d'"'"' $TEST_DIR/build/clean_src/round.sv

sed -i '"'"'/<<<<<<</d'"'"' $TEST_DIR/build/clean_src/specialcase.sv
sed -i '"'"'/=======/d'"'"' $TEST_DIR/build/clean_src/specialcase.sv
sed -i '"'"'/>>>>>>>/d'"'"' $TEST_DIR/build/clean_src/specialcase.sv

sed -i '"'"'/<<<<<<</d'"'"' $TEST_DIR/build/clean_src/unpack.sv
sed -i '"'"'/=======/d'"'"' $TEST_DIR/build/clean_src/unpack.sv
sed -i '"'"'/>>>>>>>/d'"'"' $TEST_DIR/build/clean_src/unpack.sv

echo "Compiling Vtestbench..."
mkdir -p $WALLY/sim/verilator/wkdir/rv64gc_testbench

# Find all other files to compile except the conflicting ones
ALL_SRC=$(find $WALLY/src -name "*.sv" | grep -v "fcvt.sv" | grep -v "round.sv" | grep -v "specialcase.sv" | grep -v "unpack.sv")

make -C $WALLY/sim/verilator compile \
  WALLYCONF=rv64gc \
  TESTBENCH=testbench \
  INCLUDE_PATH="-I$TEST_DIR/build/clean_inc/shared -I$TEST_DIR/build/clean_inc/rv64gc -I$WALLY/config/shared -I$WALLY/config/rv64gc -I$WALLY/config/deriv/rv64gc" \
  SOURCES="$WALLY/src/cvw.sv $WALLY/testbench/testbench.sv $WALLY/testbench/common/*.sv $ALL_SRC $TEST_DIR/build/clean_src/*.sv" || true

echo "Touching executable..."
touch -d "+1 day" $WALLY/sim/verilator/wkdir/rv64gc_testbench/Vtestbench

echo "Compiling ELFs..."
riscv64-unknown-elf-gcc -march=rv64gc -mabi=lp64d -nostdlib -nostartfiles -T $WALLY/tests/riscof/spike/env/link.ld $TEST_DIR/tests/test_pmp_mmode_control.S -o $TEST_DIR/build/test_pmp_mmode_control.elf
riscv64-unknown-elf-gcc -march=rv64gc -mabi=lp64d -nostdlib -nostartfiles -T $WALLY/tests/riscof/spike/env/link.ld $TEST_DIR/tests/test_pmp_mmode_store_cross.S -o $TEST_DIR/build/test_pmp_mmode_store_cross.elf
EOF
chmod +x /home/rafay/miniconda3/WallyGuard2/runs/20260918T105234Z-b204db37/build_reproducer.sh
bash /home/rafay/miniconda3/WallyGuard2/runs/20260918T105234Z-b204db37/build_reproducer.sh
'

