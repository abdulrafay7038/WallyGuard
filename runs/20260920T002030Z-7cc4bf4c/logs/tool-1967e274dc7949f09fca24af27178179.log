    // Set senvcfg.CBZE (bit 7) to 1
    li t0, 0x80
    csrs 0x10A, t0

    // Setup mstatus.MPP = 1 (S-mode), MPIE=0
    li t0, 0x800  // MPP=1
    csrs mstatus, t0
    // clear MPIE, MIE
    li t0, 0x88
    csrc mstatus, t0

    // Setup mepc
    la t0, smode_entry
    csrw mepc, t0

    mret

smode_entry:
