#include "selfcheck.h"
.section .text.init
.option norvc
.globl rvtest_entry_point
rvtest_entry_point:
    la t0, trap_handler
    csrw mtvec, t0

    // PMP setup to allow S/U mode memory access
    li t0, -1
    csrw pmpaddr0, t0
    li t0, 0x1f
