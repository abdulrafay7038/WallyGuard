#include "selfcheck.h"

.section .text.init
.option norvc
.globl _start
_start:
    la t0, trap_handler
    csrw mtvec, t0

    # Configure PMP to allow all accesses (NAPOT)
    li t0, -1
    csrw pmpaddr0, t0
    li t0, 0x1F
    csrw pmpcfg0, t0

    # Set mstateen0[62] = 1 (enable ENVCFG for lower modes)
    li t0, 1
    slli t0, t0, 62
    csrs 0x30c, t0 # mstateen0

    # Set menvcfg.CBZE = 1 (bit 7)
    li t0, 128
    csrs 0x30a, t0 # menvcfg

    # Set senvcfg.CBZE = 1 (bit 7)
    csrs 0x10a, t0 # senvcfg

    # Switch to S-mode (MPP=1)
    li t0, 0x1800 # clear MPP
    csrc mstatus, t0
    li t0, 0x0800 # set MPP to 1 (S-mode)
    csrs mstatus, t0
    la t0, smode_entry
    csrw mepc, t0
    mret

smode_entry:
    # Read senvcfg, no trap should happen
    csrr t1, 0x10A

    # Execute cbo.zero on scratch_buf
    la a0, scratch_buf
    cbo.zero 0(a0)

    # Success, exit with PASS
    j wg_pass

.balign 4
trap_handler:
    # Any trap is a failure in control
    li a0, 1
    li a1, 0
    li a2, 0
    csrr a3, mcause
    j wg_fail

WG_FINISH

.section .data
.balign 64
scratch_buf:
