            "import os, subprocess; TEST_DIR='/home/rafay/miniconda3/WallyGuard2/runs/20260920T002030Z-7cc4bf4c'; bash_script = f'''#!/bin/bash\nset -e\ncd {TEST_DIR}\nriscv64-unknown-elf-gcc -march=rv64gc_zicboz_smstateen -mabi=lp64 -mcmodel=medany -T linker.ld -nostdlib -nostartfiles control.S -o build/control.elf\nriscv64-unknown-elf-gcc -march=rv64gc_zicboz_smstateen -mabi=lp64 -mcmodel=medany -T linker.ld -nostdlib -nostartfiles test.S -o build/test.elf\n'''; open(f'{TEST_DIR}/linker.ld', 'w').write('OUTPUT_ARCH(\"riscv\")\\nENTRY(_start)\\nSECTIONS { . = 0x80000000; .text.init : { *(.text.init) } .text : { *(.text) } .data : { *(.data) } .bss : { *(.bss) } . = ALIGN(64); .tohost : { *(.tohost) } _end = .; }\\n'); open(f'{TEST_DIR}/control.S', 'w').write('.section .text.init\\n.globl _start\\n_start:\\n la t0, trap_handler\\n csrw mtvec, t0\\n li t0, -1\\n csrw pmpaddr0, t0\\n li t0, 0x1F\\n csrw pmpcfg0, t0\\n li t0, 1\\n slli t0, t0, 62\\n csrs 0x30c, t0\\n li t0, 0x80\\n csrs 0x30a, t0\\n csrs 0x10a, t0\\n li t0, 0x800\\n csrs mstatus, t0\\n la t0, smode_entry\\n csrw mepc, t0\\n mret\\nsmode_entry:\\n csrr t1, 0x10a\\n la a0, scratch\\n cbo.zero (a0)\\n li t0, 1\\n la t1, tohost\\n sd t0, 0(t1)\\n1: j 1b\\n.balign 4\\ntrap_handler:\\n li t0, 3\\n la t1, tohost\\n sd t0, 0(t1)\\n1: j 1b\\n.section .data\\n.balign 64\\nscratch: .dword 0,0,0,0,0,0,0,0\\n.section .tohost, \"aw\", @progbits\\n.balign 64\\n.globl tohost\\n.globl fromhost\\ntohost: .dword 0\\nfromhost: .dword 0\\n'); open(f'{TEST_DIR}/test.S', 'w').write('.section .text.init\\n.globl _start\\n_start:\\n la t0, trap_handler\\n csrw mtvec, t0\\n li t0, -1\\n csrw pmpaddr0, t0\\n li t0, 0x1F\\n csrw pmpcfg0, t0\\n li t0, 1\\n slli t0, t0, 62\\n csrc 0x30c, t0\\n li t0, 0x80\\n csrs 0x30a, t0\\n li t0, 0x800\\n csrs mstatus, t0\\n la t0, smode_entry\\n csrw mepc, t0\\n mret\\nsmode_entry:\\n csrr t1, 0x10a\\n li t0, 3\\n la t1, tohost\\n sd t0, 0(t1)\\n1: j 1b\\n.balign 4\\ntrap_handler:\\n csrr t0, m