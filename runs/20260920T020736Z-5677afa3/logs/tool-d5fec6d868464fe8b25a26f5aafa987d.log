commit e065a89e6fe4a4b4c283e8caff95f6f36a9aabf7
Author: David Harris <David_Harris@hmc.edu>
Date:   Wed Sep 16 05:42:22 2026 -0700

    Comment why amoalu selects the word compare when Zabha is disabled
    
    Answers a review question on #1877: without Zabha the byte and halfword AMO
    encodings are illegal and never reach the LSU, so those two case arms are
    don't-cares.  Selecting lt32 rather than lt8/lt16 there is a synthesis
    optimization, leaving the narrow signed-compare muxes with no consumer so the
    tool can trim them.  No functional change.
    
    Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>

diff --git a/src/lsu/amoalu.sv b/src/lsu/amoalu.sv
index 83d6dd69a..eb0c62707 100644
--- a/src/lsu/amoalu.sv
+++ b/src/lsu/amoalu.sv
@@ -74,7 +74,8 @@ module amoalu import cvw::*;  #(parameter cvw_t P) (
     assign lt64  = (sngd & (a[63] ^ b[63])) ? a[63] : ltu64;
   end
 
-  // Pick the compare matching the access width
+  // Pick the compare matching the access width.  Without Zabha the byte and halfword cases are
+  // don't-cares; lt32 is chosen there as a synthesis optimization so lt8 and lt16 are trimmed.
   always_comb
     case (LSUFunct3M[1:0])
       2'b00:   lt = P.ZABHA_SUPPORTED ? lt8  : lt32; // amo*.b

